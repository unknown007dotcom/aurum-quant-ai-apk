# Copy to .env and fill in. Docs: docs/ENVIRONMENT.md
# Every variable the Node/Vercel side reads. tests/env-docs.test.js enforces this.

PORT=3000

# --- Admin (deny-by-default: empty means every admin request is DENIED) ---
ADMIN_PASSWORD=

# --- Cron endpoints (empty = /api/auto-analyze and /api/auto-learn return 503) ---
CRON_SECRET=
AUTO_ANALYZE_BASE_URL=

# --- OANDA ---
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENVIRONMENT=practice
OANDA_INSTRUMENT=XAU_USD

# --- Trading bot ---
TRADING_BOT_ALLOW_LIVE=false
# Hard live-trading risk limits (lib/risk-limits.js), enforced server-side.
# A breach blocks the tick; it is never clamped.
RISK_MAX_UNITS=1000
RISK_MAX_OPEN_POSITIONS=1
RISK_MAX_DAILY_LOSS=100
RISK_MAX_DAILY_ORDERS=20
# true = block every live order immediately, regardless of bot mode.
RISK_KILL_SWITCH=false

# --- Persistence ---
# Single-line service-account JSON. Without it, local JSON files are used.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Market/options data (comma-separated pools accepted) ---
TWELVE_DATA_API_KEY=
TWELVE_DATA_API_KEYS=
POLYGON_API_KEY=
POLYGON_API_KEYS=
ALPHA_VANTAGE_KEY=
ALPHA_VANTAGE_KEYS=
MASSIVE_API_KEY=
MASSIVE_API_KEYS=
OPTIONS_DATA_API_KEY=
OPTIONS_DATA_API_KEYS=
